{
  "name": "zoomdata",
  "version": "0.1.0",
  "description": "Zoomable height maps and other two-dimensional scientific data in the browser, with exact values, drawn from NetCDF tile pyramids",
  "keywords": [
    "visualization",
    "deep-zoom",
    "scientific-data",
    "netcdf",
    "webgl",
    "height-map",
    "topography"
  ],
  "homepage": "https://github.com/ContactEngineering/zoomdata#readme",
  "bugs": {
    "url": "https://github.com/ContactEngineering/zoomdata/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContactEngineering/zoomdata.git"
  },
  "license": "MIT",
  "author": "contact.engineering",
  "type": "module",
  "main": "./dist/zoomdata.umd.cjs",
  "module": "./dist/zoomdata.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zoomdata.js",
      "require": "./dist/zoomdata.umd.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "demo:data": "python demo/make_demo_data.py",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && vue-tsc --noEmit -p demo/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --project unit",
    "test:render": "vitest run --project render",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
